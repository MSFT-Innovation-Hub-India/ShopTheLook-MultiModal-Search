# Azure OpenAI Configuration
AZURE_OPENAI_ENDPOINT=https://stl-project-llm.openai.azure.com/
AZURE_OAI_DEPLOYMENT=gpt-4o
AZURE_OPENAI_EMBEDDING_MODEL=text-embedding-ada-002
AZURE_OAI_API_VERSION=2024-05-01-preview
# Azure OpenAI uses Managed Identity (DefaultAzureCredential) - no API key needed.
# Ensure the runtime identity has the 'Cognitive Services OpenAI User' role on the Azure OpenAI resource.
# Azure Computer Vision Configuration (for Multimodal Embeddings)
# Auth via Managed Identity (DefaultAzureCredential). Identity needs 'Cognitive Services User' role.
AZURE_COMPUTER_VISION_ENDPOINT=https://stl-ai-vision.cognitiveservices.azure.com/

# Azure AI Search Configuration
# Auth via Managed Identity. Identity needs 'Search Index Data Reader' (and 'Search Service Contributor' if managing the index).
AZURE_SEARCH_SERVICE_ENDPOINT=https://stl-ai-search.search.windows.net
AZURE_SEARCH_INDEX_NAME=build-multimodal-demo
