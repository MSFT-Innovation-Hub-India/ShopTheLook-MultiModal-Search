# Azure OpenAI Configuration
AZURE_OPENAI_ENDPOINT=https://your-openai-resource.openai.azure.com/
AZURE_OAI_DEPLOYMENT=gpt-4o
AZURE_OPENAI_EMBEDDING_MODEL=text-embedding-ada-002
AZURE_OAI_API_VERSION=2024-05-01-preview
AZURE_OPENAI_API_KEY=your_openai_api_key_here
# Azure Computer Vision Configuration (for Multimodal Embeddings)
AZURE_COMPUTER_VISION_ENDPOINT=https://stl-ai-vision.cognitiveservices.azure.com/
AZURE_COMPUTER_VISION_API_KEY=your_computer_vision_api_key_here

# Azure AI Search Configuration
AZURE_SEARCH_SERVICE_ENDPOINT=https://stl-ai-search.search.windows.net
AZURE_SEARCH_INDEX_NAME=build-multimodal-demo
AZURE_SEARCH_API_KEY=your_search_api_key_here
